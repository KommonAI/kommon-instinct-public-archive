+
+# ---------------------------------------------------------------------------
+# Inkbox (https://inkbox.ai/docs/signing-keys)
+# ---------------------------------------------------------------------------
+
+INKBOX_SIGNATURE_HEADER = "x-inkbox-signature"
+INKBOX_TIMESTAMP_HEADER = "x-inkbox-timestamp"
+INKBOX_REQUEST_ID_HEADER = "x-inkbox-request-id"
+_INKBOX_SIGNATURE_PREFIX = "sha256="
+_INKBOX_KEY_PREFIX = "whsec_"
+
+
+def inkbox_v1_signature(secret: str, request_id: str, timestamp: str, raw_body: bytes) -> str:
+    """Returns the ``X-Inkbox-Signature`` value for one delivery.
+
+    The value is ``sha256=`` plus the lowercase hex HMAC-SHA256 of
+    ``request_id + "." + timestamp + "." + raw_body`` with the identity's
+    signing key as the key. Inkbox shows the key with a ``whsec_`` prefix;
+    the prefix is not part of the key material.
+    """
+    key = secret[len(_INKBOX_KEY_PREFIX):] if secret.startswith(_INKBOX_KEY_PREFIX) else secret
+    base = f"{request_id}.{timestamp}.".encode() + raw_body
+    digest = hmac.new(key.encode(), base, hashlib.sha256).hexdigest()
+    return f"{_INKBOX_SIGNATURE_PREFIX}{digest}"
+
+
+def verify_inkbox_v1(
+    secret: str,
+    headers: dict[str, str],
+    raw_body: bytes,
+    now_seconds: float | None = None,
+) -> bool:
+    """Returns True when the request carries a valid, fresh Inkbox signature.
+
+    Inkbox signs every webhook delivery (iMessage, SMS, mail, A2A) the same
+    way, so one scheme covers every channel of an agent identity.
+    """
+    provided = headers.get(INKBOX_SIGNATURE_HEADER)
+    timestamp = headers.get(INKBOX_TIMESTAMP_HEADER)
+    request_id = headers.get(INKBOX_REQUEST_ID_HEADER)
+    if not provided or not timestamp or not request_id:
+        return False
+    try:
+        timestamp_seconds = float(timestamp)
+    except ValueError:
+        return False
+    current = time.time() if now_seconds is None else now_seconds
+    if abs(current - timestamp_seconds) > REPLAY_TOLERANCE_SECONDS:
+        return False
+    expected = inkbox_v1_signature(secret, request_id, timestamp, raw_body)
+    return hmac.compare_digest(expected, provided)
+
+
+VERIFIERS = {
+    "spectrum_v0": verify_spectrum_v0,
+    "inkbox_v1": verify_inkbox_v1,
+}
+
+
+def verify_delivery(scheme: str, secret: str, headers: dict[str, str], raw_body: bytes) -> bool:
+    """Dispatches to the verifier of ``scheme``; unknown schemes never verify."""
+    verifier = VERIFIERS.get(scheme)
+    return bool(verifier and verifier(secret, headers, raw_body))
diff -ruN a/backend/tests/test_signed_webhooks_inkbox.py b/backend/tests/test_signed_webhooks_inkbox.py
--- a/backend/tests/test_signed_webhooks_inkbox.py	2026-10-03 12:23:27
+++ b/backend/tests/test_signed_webhooks_inkbox.py	2026-10-03 12:23:27
@@ -0,0 +1,61 @@
+"""The inkbox_v1 scheme: one signed address receives every Inkbox webhook of an agent identity."""
+
+import hashlib
+import hmac
+import json
+import time
+
+import pytest
+
+from app.signed_webhooks.signatures import inkbox_v1_signature, verify_delivery, verify_inkbox_v1
+
+SECRET = "whsec_" + "k" * 40
+BODY = json.dumps({"id": "evt_1", "event_type": "imessage.received", "data": {}}).encode()
+
+
+def _headers(secret: str = SECRET, body: bytes = BODY, request_id: str = "req_1", ts: float | None = None):
+    timestamp = str(int(ts if ts is not None else time.time()))
+    return {
+        "x-inkbox-request-id": request_id,
+        "x-inkbox-timestamp": timestamp,
+        "x-inkbox-signature": inkbox_v1_signature(secret, request_id, timestamp, body),
+    }
+
+
+def test_signature_matches_the_documented_construction():
+    key = SECRET[len("whsec_"):]
+    expected = hmac.new(key.encode(), b"req_1.1700000000." + BODY, hashlib.sha256).hexdigest()
+    assert inkbox_v1_signature(SECRET, "req_1", "1700000000", BODY) == f"sha256={expected}"
+    # The prefix is cosmetic: with or without it the same key signs the same bytes.
+    assert inkbox_v1_signature(key, "req_1", "1700000000", BODY) == f"sha256={expected}"
+
+
+def test_valid_fresh_signature_is_accepted():
+    assert verify_inkbox_v1(SECRET, _headers(), BODY)
+    assert verify_delivery("inkbox_v1", SECRET, _headers(), BODY)
+
+
+@pytest.mark.parametrize(
+    "mutate",
+    [
+        lambda h: {**h, "x-inkbox-signature": "sha256=" + "0" * 64},
+        lambda h: {k: v for k, v in h.items() if k != "x-inkbox-request-id"},
+        lambda h: {**h, "x-inkbox-request-id": "req_other"},
+        lambda h: {**h, "x-inkbox-timestamp": "not-a-number"},
+    ],
+)
+def test_invalid_signature_is_rejected(mutate):
+    assert not verify_inkbox_v1(SECRET, mutate(_headers()), BODY)
+
+
+def test_wrong_secret_is_rejected():
+    assert not verify_inkbox_v1("whsec_" + "x" * 40, _headers(), BODY)
+
+
+@pytest.mark.parametrize("offset", [-301, 301])
+def test_signature_outside_the_replay_window_is_rejected(offset):
+    assert not verify_inkbox_v1(SECRET, _headers(ts=time.time() + offset), BODY)
+
+
+def test_unknown_scheme_never_verifies():
+    assert not verify_delivery("nope", SECRET, _headers(), BODY)
